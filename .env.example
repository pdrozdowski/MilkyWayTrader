# Public browser configuration for Supabase authentication and telemetry.
# Copy to the Git-ignored .env.local and use the matching environment's project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GAME_VERSION=

# This file contains public browser values only. Never put Cloudflare tokens, Google
# client secrets, Supabase service-role/secret keys, or Function secrets here.
